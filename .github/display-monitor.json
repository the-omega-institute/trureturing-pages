{
  "schema": "omega.display-monitor.v1",
  "repository": "the-omega-institute/trureturing-pages",
  "checks": [
    {
      "id": "home",
      "url": "https://www.trureturing.org/",
      "owner": "the-omega-institute/trureturing-pages",
      "kind": "html",
      "contains": "trureturing"
    },
    {
      "id": "atlas",
      "url": "https://www.trureturing.org/data/atlas-startup.v1.json",
      "owner": "the-omega-institute/trureturing-pages",
      "kind": "json",
      "equals": {
        "schema_version": "pages-atlas-startup.v1"
      },
      "required": [
        "truth_release_digest",
        "graph",
        "layout"
      ]
    },
    {
      "id": "publication-feed",
      "url": "https://www.trureturing.org/assets/publication-index.json",
      "owner": "the-omega-institute/trureturing-pages",
      "kind": "json",
      "equals": {
        "schema_version": "publication-index.v1"
      },
      "required": [
        "publications",
        "notes"
      ]
    },
    {
      "id": "publication-progress",
      "owner": "the-omega-institute/trureturing-pages",
      "kind": "json",
      "url": "https://www.trureturing.org/data/version-status.v1.json",
      "equals": {
        "schema_version": "pages-version-status.v1",
        "head.behind": 0
      },
      "required": [
        "observed_at"
      ]
    },
    {
      "id": "publication-observer",
      "owner": "the-omega-institute/trureturing-pages",
      "kind": "json",
      "url": "https://api.github.com/repos/the-omega-institute/trureturing-pages/commits/pages-sync-status",
      "equals": {
        "commit.message": "Observe served Pages release and upstream publication progress",
        "files.0.filename": "data/version-status.v1.json"
      },
      "timestamp": "commit.committer.date",
      "max_age_seconds": 10800
    }
  ],
  "browser": [
    {
      "id": "reader",
      "url": "https://www.trureturing.org/",
      "owner": "the-omega-institute/trureturing-pages"
    }
  ],
  "targets": {
    "the-omega-institute/trureturing-pages": {
      "branch": "dev",
      "paths": [
        "site/assets/",
        "site/index.html",
        "lib/research_updates.py",
        "lib/research_news.py"
      ],
      "verify": [
        [
          "python3",
          "-m",
          "pip",
          "install",
          "-r",
          "requirements.txt"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "tests",
          "-p",
          "test_*.py"
        ],
        [
          "bash",
          "-c",
          "node --test tests/js/*.test.mjs"
        ]
      ],
      "auto_merge": true,
      "github_service": "display-pages-github"
    },
    "the-omega-institute/trureturing-outreach-engine": {
      "branch": "main",
      "paths": [
        "managed/mathesis_delivery.py",
        "scripts/short_notes/service.py",
        "scripts/short_notes/workflow.py"
      ],
      "verify": [
        [
          "python3",
          "-m",
          "compileall",
          "-q",
          "managed",
          "scripts/short_notes"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "managed/tests"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/short_notes",
          "-p",
          "test_*.py"
        ]
      ],
      "auto_merge": false,
      "github_service": "display-outreach-github"
    }
  },
  "publisher_login": "AlyciaBHZ"
}
